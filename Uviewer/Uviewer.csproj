<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Uviewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Uviewer.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'x64')">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- 引擎源码迁入本工程后沿用原有的隐式 using 约定（System / LINQ / IO / Tasks 等）。 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!-- Re-run MSIX packaging targets whenever the source package manifest changes. -->
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildProjectDirectory)\Package.appxmanifest</MSBuildAllProjects>
  </PropertyGroup>

  <!-- Dynamically read the version from Package.appxmanifest so there is only one source of truth. -->
  <Target Name="ReadVersionFromManifest" BeforeTargets="InitializeSourceControlInformation;PrepareForBuild;GetAssemblyVersion;GenerateAssemblyInfo">
    <XmlPeek XmlInputPath="Package.appxmanifest" Query="/f:Package/f:Identity/@Version" Namespaces="&lt;Namespace Prefix='f' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;">
      <Output TaskParameter="Result" PropertyName="AppxVersion" />
    </XmlPeek>
    <PropertyGroup Condition="'$(AppxVersion)' != ''">
      <Version>$(AppxVersion)</Version>
      <AssemblyVersion>$(AppxVersion)</AssemblyVersion>
      <FileVersion>$(AppxVersion)</FileVersion>
    </PropertyGroup>
  </Target>

  <PropertyGroup Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings\en-US\Resources.resw" LogicalName="Uviewer.FallbackStrings.resw" />
    <Content Include="Assets\Uviewer.ico" />
    <Content Include="Assets\Uviewer2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Libs\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    书源引擎已从独立类库 BookSource.Core 整体迁移进本工程：
      Services/Legado/Models/   → 书源/规则的纯数据模型
      Services/Legado/Engine/   → 规则引擎、选择器、抓取、净化、存储、分章
    因此不再有 ProjectReference，引擎所需的 NuGet 依赖在此直接声明。
  -->
  <ItemGroup>
    <!-- CSS 选择器支持（HtmlAgilityPack 本体不含 QuerySelector，由该官方 companion 提供） -->
    <PackageReference Include="HtmlAgilityPack.CssSelectors" Version="1.0.2" />
    <!-- legado 书源 js 规则（@js: / <js>）求值 -->
    <PackageReference Include="Jint" Version="3.1.2" />
    <!-- 中文站点 GB18030/GBK/GB2312 解码必需：net10 默认只内置 UTF-8/16/32、ASCII、Latin1，
         缺该包时 Encoding.GetEncoding("GB18030") 直接抛 ArgumentException（响应会静默按 UTF-8 解成乱码）。
         NU1510 只是"该包不会被裁剪"的提示，与功能无关，故按包级抑制。 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" NoWarn="NU1510" />
  </ItemGroup>

  <!-- 引擎单元测试工程直接链接本源代码，故需可见 internal 成员。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Uviewer.Legado.Tests" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CSharpMath.Rendering" Version="0.5.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Use Libs\7z.dll; skip the package targets that copy x64/x86 native DLLs. -->
    <PackageReference Include="SevenZipExtractor" Version="1.0.19" ExcludeAssets="build" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="Starward.Codec" Version="0.5.2" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="WebDav.Client" Version="2.9.0" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <BuildAppxUploadPackageForUap>False</BuildAppxUploadPackageForUap>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <PackageCertificateThumbprint></PackageCertificateThumbprint>
    <PackageCertificateKeyFile>Uviewer_TemporaryKey.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword>UviewerTestCert</PackageCertificatePassword>
    <GenerateTemporaryStoreCertificate>False</GenerateTemporaryStoreCertificate>
  </PropertyGroup>
</Project>
