<ContentDialog
    x:Class="Uviewer.Dialogs.GoToLineDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Uviewer.Dialogs"
    xmlns:common="using:Uviewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="{x:Bind DialogTitle, Mode=OneTime}"
    PrimaryButtonText="{x:Bind common:Strings.DialogPrimary}"
    CloseButtonText="{x:Bind common:Strings.DialogClose}"
    DefaultButton="Primary">

    <StackPanel Width="300" Spacing="8">
        <TextBox x:Name="InputBox"
                 InputScope="Number"
                 PlaceholderText="{x:Bind Placeholder, Mode=OneTime}"
                 Text="{x:Bind CurrentLineText, Mode=TwoWay}"
                 TextChanged="InputBox_TextChanged"/>
        <Slider x:Name="PositionSlider"
                Minimum="1"
                StepFrequency="1"
                SnapsTo="StepValues"
                ValueChanged="PositionSlider_ValueChanged"/>
        <Grid>
            <TextBlock Text="1" HorizontalAlignment="Left"/>
            <TextBlock Text="{x:Bind TotalLinesText, Mode=OneTime}" HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</ContentDialog>
