<Project Sdk="Microsoft.NET.Sdk">
  <!--
    性能基准工程（样例生成 + 基准测量）。
    独立于主工程：不引入 WinUI 依赖，改为链接宿主 Services/Legado 下的引擎源码，
    保证基准测的是"算法成本"而非 UI 框架开销。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PerfBench</RootNamespace>
    <AssemblyName>PerfBench</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\..\Uviewer\Services\Legado\Models\*.cs" LinkBase="Engine\Models" />
    <Compile Include="..\..\..\Uviewer\Services\Legado\BookSources\*.cs" LinkBase="Engine\BookSources" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="HtmlAgilityPack.CssSelectors" Version="1.0.2" />
    <PackageReference Include="Jint" Version="3.1.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" NoWarn="NU1510" />
  </ItemGroup>
</Project>
